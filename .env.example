# ── Core ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://pawsome:pawsome@127.0.0.1:54329/pawsome
# Public base URL (used for sitemap, OG tags, email links)
APP_URL=http://localhost:3001

# ── First admin (used by `npm run admin:create`) ────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Private file storage ────────────────────────────────────────────
# "local" stores files on disk in STORAGE_DIR (never under /public).
# "s3" works with AWS S3, Cloudflare R2, or Supabase Storage (S3 API). Bucket must be PRIVATE.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Payments (Razorpay) ─────────────────────────────────────────────
# Leave blank to run without online payments: orders stay "payment pending"
# and the studio records UPI/bank transfers manually from the admin.
# Use rzp_test_… keys for Razorpay test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────
# Leave blank in development: emails are logged to the server console
# (customers still get in-app notifications).
RESEND_API_KEY=
EMAIL_FROM="Pawsome Memories <studio@example.com>"
